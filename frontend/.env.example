# Copy to .env.local. Never commit .env.local.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
# CARTO basemaps key for the dark map tiles (free: https://carto.com/basemaps/apikey).
# Required: without a key the maps show no streets, only an "API KEY REQUIRED" notice.
VITE_CARTO_KEY=
