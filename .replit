# Replit: one server hosts the API and the built web app on port 5000.
modules = ["python-3.11", "nodejs-20"]
run = "bash replit-build.sh && cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 5000"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
build = ["bash", "replit-build.sh"]
run = ["bash", "-c", "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 5000"]
