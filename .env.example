# Backend settings. Copy to .env at the repo root; the backend reads it on start.
# Never commit real keys.
CORS_ORIGINS=http://localhost:5173
SIMULATED_DATA=true

# Speech to text. Without a key the trigger runs on sound and movement only.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Trigger tuning
SAFE_PHRASE=red umbrella
TRIGGER_THRESHOLD=0.75

# Model for hazard summaries and incident extraction (uses GROQ_API_KEY)
GROQ_LLM_MODEL=openai/gpt-oss-20b

LLM_API_KEY=
